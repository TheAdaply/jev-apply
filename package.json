    "jev-scan": "scripts/scan.mjs",
    "jev-pipeline": "scripts/pipeline.mjs",
    "jev-canon-scan": "scripts/canon-scan.mjs",
    "jev-canon-cluster": "scripts/canon-cluster.mjs",
    "jev-canon-eval": "scripts/canon-eval.mjs",
    "jev-answers": "scripts/answers.mjs",
    "jev-smoke": "scripts/jev-smoke.mjs",
    "jev-install": "scripts/install.mjs"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "smoke": "node scripts/jev-smoke.mjs",
    "apply": "node scripts/apply.mjs",
    "learn": "node scripts/learn.mjs",
    "remember": "node scripts/remember.mjs",
    "scan": "node scripts/scan.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "canon-scan": "node scripts/canon-scan.mjs",
    "canon-cluster": "node scripts/canon-cluster.mjs",
    "canon-eval": "node scripts/canon-eval.mjs",
    "answers": "node scripts/answers.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "openai": "^7.21.0",
    "pdf-parse": "^2.4.5",
